pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'maven'
    }

    environment {
        my_aws_credentials = credentials('worker-aws-cred')
        ECR_repo = '525382241025.dkr.ecr.us-east-2.amazonaws.com/project-image'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/sakshipatode235-ai/EasyCRUD.git'
            }
        }

        stage('Build') {
            steps {
                dir('backend') {
                    sh 'mvn clean package'
                }
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: 'backend/target/*.jar',
                        fingerprint: true
                    )
                }
            }
        }

        stage('Artifact to s3') {
            steps {
                dir('backend') {
                    sh '''
                        aws s3 cp ./target/*.jar s3://artifact-2-s3/Artifacts/student.jar
                    '''
                }
            }
        }

         stage('SonarQube Analysis') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('sonar') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Quality Gates') {
            steps {
                timeout(time: 2, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Docker build'){
            steps{
                dir('backend'){
                    sh '''
                    docker build -t backend:${BUILD_NUMBER} .
                    docker images 
                    '''
                }
            }
        }
        stage('Trivy Scan') {
            steps {
                dir('backend') {
                    sh '''
                       trivy image --scanners vuln --severity HIGH,CRITICAL --exit-code 0 backend:${BUILD_NUMBER}
                    '''
                }
            }
        } 
        stage('push to ECR'){
            sh '''
            aws ecr get-login-password --region us-east-2 | docker login --username AWS --password-stdin 525382241025.dkr.ecr.us-east-2.amazonaws.com
            docker tag project-image:${BUILD_NUMBER} {ECR_repo}:${BUILD_NUMBER}
            docker push {ECR_repo}:${BUILD_NUMBER}

            '''
        }
    }
}