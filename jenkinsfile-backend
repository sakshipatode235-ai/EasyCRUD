pipeline {
    agent {
        label 'worker'
    }
    tools{
        maven 'maven'
    }
    environment{
        my_aws_credentials = credentials('worker-aws-cred')
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/sakshipatode235-ai/EasyCRUD.git'
            }
        }

        stage('Build') {
            steps {
                dir('backend') {
                    sh 'mvn clean package'
                }
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: 'backend/target/*.jar',
                        fingerprint: true
                    )
                }
            }
        }
        stage('Artifact to s3'){
            steps{
                dir('backend'){
                    sh '''
                    aws s3 cp ./target/*.jar s3://artifact-2-s3/Artifacts/student.jar
                    '''
                }
            }
        }
        stage('sonarqube analysis'){
            steps{
                dir('backend'){
                    withSonarQubeEnv('sonar'){
                        sh 'mvn sonar:sonar'
                        waitForQualityGate abortPipeline: true
                    }

                }
            }
        }
        stage('Quality-Gates'){
            steps{
                timeout(time: 30 ,unit: "MINUTES")
            }
        }

    }
}
