pipeline {
    agent {
        label 'worker'
    }

    environment {
       my_aws_credentials = credentials('worker-aws-cred')
    }

    
    stages{
        stage('Checkout') {
            steps {
                git branch: 'main', credentialsId: 'github-cred', url: 'https://github.com/sakshipatode235-ai/EasyCRUD.git'
            }
        }

        stage('TERRAFORM - INIT'){
            steps {
                sh 'terraform init'
            }
        }

        stage('TERRAFORM - FMT - VALIDATE') {
            steps {
                sh '''
                    terraform fmt 
                    terraform validate
                '''
            }
        }

        stage('TERRAFORM - PLAN ') {
            steps {
                sh 'terraform plan'
            }
        }

        stage('TERRAFORM - APPLY ') {
            steps {
                sh 'terraform apply -auto-approve'
            }
        }
    }
}