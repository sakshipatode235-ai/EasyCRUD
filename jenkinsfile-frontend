pipeline {
    stages{
        stage('git checkout'){
            steps{
                git branch: "main", credentialsId "github-cred"
            }
        }
        stage('build-frontend'){
            steps{
                dir('frontend'){
                    sh'''
                    npm install 
                    npm run 
                    '''

                }
            }
            post {
                sucesss{
                    archiveArtifacts artifacts: '/frontend/dist' , fingerprint:true
                }
            }
        }
        stage('artifact to s3 '){
            steps{
                sh '''
                aws s3 sync 'frontend/dist/**' s3://artifact-2-s3/Artifacts/

                '''
            }
        }
        stage('Docker Build'){
            steps{
                dir('frontend'){
                    sh '''
                    docker rmi -f $(docker images -q)
                    docker build -t frontend:{BUILD_NUMBER} .
                    docker images
                    '''
                }
            }
        }
}