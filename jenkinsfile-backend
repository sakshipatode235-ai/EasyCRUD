pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'maven'
    }

    environment {
        my_aws_credentials = credentials('worker-aws-cred')
        ECR_REPO = '525382241025.dkr.ecr.us-east-2.amazonaws.com/project-image'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-cred',
                    url: 'https://github.com/sakshipatode235-ai/EasyCRUD.git'
            }
        }

        stage('Build') {
            steps {
                dir('backend') {
                    sh 'mvn clean package'
                }
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: 'backend/target/*.jar',
                        fingerprint: true
                    )
                }
            }
        }

        stage('Artifact to s3') {
            steps {
                dir('backend') {
                    sh '''
                        aws s3 cp ./target/*.jar \
                        s3://artifact-2-s3/Artifacts/student.jar
                    '''
                }
            }
        }

        stage('Docker build') {
            steps {
                dir('backend') {
                    sh '''
                        docker build -t backend:${BUILD_NUMBER} .
                        docker images
                    '''
                }
            }
        }

        stage('push to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region us-east-2 | \
                    docker login --username AWS --password-stdin \
                    525382241025.dkr.ecr.us-east-2.amazonaws.com

                    docker tag backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}

                    docker push ${ECR_REPO}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Update Manifest') {
            steps {
                sh '''
                    sed -i "s|image: .*|image: ${ECR_REPO}:${BUILD_NUMBER}|" \
                    k8s/backend/backend-deployment.yaml
                '''
            }
        }

        stage('Push change to GITHUB') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-cred',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {
                    sh '''
                        git config user.name "sakshipatode235-ai"
                        git config user.email "sakshipatode235@gmail.com"

                        git add k8s/backend/backend-deployment.yaml
                        git commit -m "Update backend-deployment"

                        git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/sakshipatode235-ai/EasyCRUD.git HEAD:main
                    '''
                }
            }
        }

        stage('Update ArgoCD') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'worker-aws-cred'
                ]]) {
                    sh '''
                        aws sts get-caller-identity

                        aws eks update-kubeconfig \
                            --name my-eks-cluster1 \
                            --region us-east-2

                        kubectl apply -f argocd/backend-application.yaml
                        kubectl apply -f argocd/ingress-application.yaml
                        // kubectl apply -f k8s/ingress/ingress.yaml
                        kubectl get applications -n argocd
                    '''
                }
            }
        }
    }
}