pipeline {
    agent{
        label 'worker'
    }
    environment{
        ECR_repo = '525382241025.dkr.ecr.us-east-2.amazonaws.com/frontend-image'
    }
    stages{
        stage('git checkout'){
            steps{
                git branch: "main", credentialsId: "github-cred" ,url : "https://github.com/sakshipatode235-ai/EasyCRUD.git"
            }
        }
        stage('Build-frontend') {
            steps {
                dir('frontend') {
                    sh '''
                        npm install 
                        npm run build
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true
                }
            }
        }
        stage('artifact to s3 '){
            steps{
                sh '''
                aws s3 sync frontend/dist s3://artifact-2-s3/Artifacts/

                '''
            }
        }
        stage('Docker Build'){
            steps{
                dir('frontend'){
                    sh '''
                    docker rmi -f $(docker images -q)
                    docker build -t frontend-image:${BUILD_NUMBER} .
                    docker images
                    '''
                }
            }
        }
        stage('trivy image scanning'){
            steps{
                
                sh '''
                trivy image --scanners vuln --severity HIGH,CRITICAL --exit-code 0 frontend-image:${BUILD_NUMBER}
                '''
            }
        }
        stage('Push to ECR'){
            steps{
                sh '''
                aws ecr get-login-password --region us-east-2 | docker login --username AWS --password-stdin 525382241025.dkr.ecr.us-east-2.amazonaws.com
                docker tag frontend-image:${BUILD_NUMBER} ${ECR_repo}:${BUILD_NUMBER}
                docker push ${ECR_repo}:${BUILD_NUMBER}

                '''
            }
        }
        stage('update manifest'){
            steps{
                sh '''
                sed -i " s|image: .*|image:${ECR_repo}:${BUILD_NUMBER}|" /k8s/frontend/frontend-deployment.yaml

                '''
            }

        }

    }
}
